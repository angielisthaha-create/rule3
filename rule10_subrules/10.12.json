  "subdivision": {
    "number": 4,
    "heading": "Right of Review"
  },
  "operative_text": {
    "controlling": "10.12(1)  Where a lawyer carries on business in Alberta, the\nlawyer’s charges may be reviewed by a review officer at the\njudicial centre nearest to where the lawyer carries on business.\n(2)  Where a lawyer does not carry on business in Alberta but the\nclient resides in Alberta, the lawyer’s charges may be reviewed by\na review officer at the judicial centre nearest to where the client\nresides.\n(3)  Notwithstanding subrules (1) and (2), and in any other case, the\nCourt may designate a location for the review of the lawyer’s\ncharges.",
    "controlling_carrier": "OFFICIAL",
    "sha256": "2513f79d291e36a34d556a1f297f88ac1b5abb3c1880630c54ce106282328c3f"
  },
